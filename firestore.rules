rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Segédfüggvények ----------
    function signedIn() {
      return request.auth != null;
    }

    // A meghívó dokumentumazonosítója a kisbetűs e-mail-cím.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isDisabled() {
      return hasProfile() &&
        (me().get('isDisabled', false) == true
          || me().get('accountStatus', '') == 'disabled');
    }

    function isAdmin() {
      return hasProfile()
        && !isDisabled()
        && me().role == 'Főszervező'
        && (!me().keys().hasAny(['accountStatus']) || me().get('accountStatus', '') == 'active');
    }

    function isOrganizer() {
      return hasProfile() && me().role == 'Szervező';
    }

    function isJudge() {
      return hasProfile() && me().role == 'Zsűri';
    }

    // Jóváhagyott felhasználó (a főszervezőnek nem kell jóváhagyás)
    function isApproved() {
      return hasProfile()
        && !isDisabled()
        && (
          (me().role == 'Főszervező'
            && (!me().keys().hasAny(['accountStatus']) || me().get('accountStatus', '') == 'active'))
          || me().get('accountStatus', '') == 'active'
          || (!me().keys().hasAny(['accountStatus']) && me().get('isVerified', false) == true)
        );
    }

    function isCaptain() {
      return isApproved() &&
        (me().role == 'Csapatkapitány' || me().role == 'Alcsapatkapitány');
    }

    function canManageTeamSponsors() {
      return isApproved()
        && isCaptain()
        && me().team is string
        && me().team != ''
        && exists(/databases/$(database)/documents/teams/$(me().team));
    }

    // ---------- Felhasználók ----------
    match /users/{uid} {
      // Saját profil olvasása, vagy admin: bárkié (igazolások ellenőrzéséhez)
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();

      // Profilokat és szerepkör-/csapat-hozzárendeléseket kizárólag a megbízható backend hoz létre.
      allow create: if false;

      // Saját profilnál a szerepkör és a csapat nem módosítható,
      // jóváhagyni (isVerified = true) csak az admin tud.
      allow update: if (isAdmin()
        && (request.auth.uid != uid || request.resource.data.role == resource.data.role))
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'profileImage', 'igazolas', 'updatedAt'])
            && request.resource.data.role == resource.data.role
            && request.resource.data.team == resource.data.team
            && request.resource.data.email == resource.data.email
            && request.resource.data.isVerified == resource.data.isVerified
            && request.resource.data.get('accountStatus', null) == resource.data.get('accountStatus', null)
            && request.resource.data.get('membershipStatus', null) == resource.data.get('membershipStatus', null));

      allow delete: if isAdmin();
    }

    // ---------- Csapatok ----------
    match /teams/{teamId} {
      allow read: if isApproved();
      // Csapatot csak jóváhagyott kapitányi kérelem után hozhat létre a backend.
      allow create: if false;
      // A főszervező bármelyiket, a kapitány/alkapitány csak a saját csapatát szerkesztheti.
      allow update: if isAdmin()
        || (isCaptain() && me().team == teamId);
      allow delete: if isAdmin();
    }

    // ---------- Programok (események) ----------
    match /programs/{programId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();   // esemény törlése csak főszervezőnek
    }

    // ---------- Értesítések (üzenőfal) ----------
    match /notifications/{notifId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();   // csak admin írhat ki üzenetet
    }

    // ---------- Galéria ----------
    match /gallery/{docId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update, delete: if isAdmin();
    }

    // ---------- Galéria, nagy képek ----------
    match /gallery_images/{docId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update, delete: if isAdmin();
    }

    // ---------- Programok, nagy képek ----------
    match /program_images/{docId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    // ---------- Szponzorok ----------
    match /sponsors/{sponsorId} {
      // Minden jóváhagyott felhasználó láthatja a szponzorokat.
      allow read: if isApproved();
      // Csak a saját csapat kapitánya/alkapitánya kezelheti a szponzorokat.
      allow create: if canManageTeamSponsors()
        && request.resource.data.keys().hasAll(['name', 'logo', 'team'])
        && request.resource.data.keys().hasOnly(['name', 'logo', 'team'])
        && request.resource.data.team == me().team
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.logo is string
        && request.resource.data.logo.size() > 0;
      allow update: if canManageTeamSponsors()
        && resource.data.team == me().team
        && request.resource.data.keys().hasAll(['name', 'logo', 'team'])
        && request.resource.data.keys().hasOnly(['name', 'logo', 'team'])
        && request.resource.data.team == me().team
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.logo is string
        && request.resource.data.logo.size() > 0;
      allow delete: if canManageTeamSponsors() && resource.data.team == me().team;
    }

    // ---------- Térkép ----------
    match /map_points/{pointId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // ---------- Fotóvadászat ----------
    match /photohunt_uploads/{uploadId} {
      allow read: if isApproved();
      // A dokumentum azonosítója: <uid>_<feladatId>
      allow create, update: if isApproved() && uploadId.matches(request.auth.uid + '_.*');
      allow delete: if isAdmin();
    }

    // ---------- Meghívók ----------
    match /invites/{inviteId} {
      allow get: if isAdmin()
        || (signedIn() && request.auth.token.email != null && inviteId == myEmail());
      allow list: if isAdmin();
      // Meghívók létrehozása, lejárat-ellenőrzése és beváltása csak backend tranzakcióval történhet.
      allow create, update, delete: if false;
    }

    match /captain_registration_codes/{codeHash} {
      allow read, write: if false;
    }

    match /captain_registrations/{uid} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // ---------- E-mail küldés (Trigger Email bővítmény) ----------
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // ---------- Minden más tiltva ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
